# Copy to .env and edit. Placeholders only; never commit real values.
APP_ENV=development
APP_NAME=GEONOVA API
APP_VERSION=0.1.0
# Comma-separated list of allowed browser origins. Use exact origins in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL + PostGIS (psycopg v3 driver). Replace CHANGE_ME with your own password.
DATABASE_URL=postgresql+psycopg://geonova_user:CHANGE_ME@localhost:5432/geonova
# Tests only. Must be a SEPARATE database whose name ends with _test.
TEST_DATABASE_URL=postgresql+psycopg://geonova_user:CHANGE_ME@localhost:5432/geonova_test
# Write endpoints (POST). Default: on only when APP_ENV=development.
# API_WRITES_ENABLED=false
